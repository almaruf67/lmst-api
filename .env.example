APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lmst
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Reverb realtime broadcasting
REVERB_APP_ID=lmst-local
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API docs & caching
SCRAMBLE_UI_TITLE="LMST API Docs"
SCRAMBLE_PROD_URL=https://api.example.com/api
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_LIFETIME=1800
RESPONSE_CACHE_STORE=database

# Activity log
ACTIVITY_LOGGER_DEFAULT_NAME=audit
ACTIVITY_LOGGER_AUTH_DRIVER=sanctum

# Backups
BACKUP_NAME="LMST API"
BACKUP_DISK=local
BACKUP_MONITOR_DISK=local
BACKUP_NOTIFICATION_EMAIL=hello@example.com
BACKUP_MAX_AGE_DAYS=1
BACKUP_MAX_STORAGE_MB=5000

# Health monitoring
HEALTH_NOTIFICATIONS_ENABLED=false
HEALTH_NOTIFICATION_EMAIL=hello@example.com
HEALTH_SECRET_TOKEN=
HEALTH_THEME=light

# Observability dashboards
PULSE_ENABLED=false
PULSE_PATH=pulse
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope

# Sanctum token expiries (minutes)
SANCTUM_ACCESS_TOKEN_EXPIRY=60
SANCTUM_REFRESH_TOKEN_EXPIRY=43200

# Dashboard caching (seconds)
DASHBOARD_CACHE_TTL=60

# Monthly report caching (seconds)
MONTHLY_REPORT_CACHE_TTL=3600
